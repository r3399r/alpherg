---
interface Hint {
  text: string;
  image?: string;
}

interface Props {
  hints: Hint[];
}

const { hints } = Astro.props;
---

<div class="hints-list">
  {hints.map((hint, i) => (
    <div class="hint-item" data-revealed="false">
      <button class="hint-btn" type="button" aria-expanded="false">
        <span class="hint-num">Hint {i + 1}</span>
        <span class="lock-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Click to reveal
        </span>
        <span class="chevron" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </span>
      </button>
      <div class="hint-body" aria-hidden="true">
        <p class="hint-text">{hint.text}</p>
        {hint.image && (
          <img src={hint.image} alt={`Hint ${i + 1} screenshot`} loading="lazy" class="hint-image" />
        )}
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.hint-item').forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('.hint-btn');
    const body = item.querySelector<HTMLElement>('.hint-body');
    if (!btn || !body) return;

    btn.addEventListener('click', () => {
      const isRevealed = item.dataset.revealed === 'true';
      item.dataset.revealed = isRevealed ? 'false' : 'true';
      btn.setAttribute('aria-expanded', isRevealed ? 'false' : 'true');
      body.setAttribute('aria-hidden', isRevealed ? 'true' : 'false');
    });
  });
</script>

<style>
  .hints-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hint-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--hint-locked);
    transition: border-color 0.2s;
  }

  .hint-item[data-revealed="true"] {
    border-color: var(--accent-dim);
    background: var(--revealed-bg);
  }

  .hint-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text);
    text-align: left;
    font-size: 0.95rem;
  }

  .hint-btn:hover {
    background: rgba(167, 139, 250, 0.06);
  }

  .hint-num {
    font-weight: 600;
    color: var(--accent);
    min-width: 4rem;
  }

  .lock-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    flex: 1;
    transition: opacity 0.2s;
  }

  .hint-item[data-revealed="true"] .lock-label {
    opacity: 0;
  }

  .chevron {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.25s ease;
    display: flex;
    align-items: center;
  }

  .hint-item[data-revealed="true"] .chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .hint-body {
    display: none;
    padding: 0 1.1rem 1rem;
    animation: fadeIn 0.2s ease;
  }

  .hint-item[data-revealed="true"] .hint-body {
    display: block;
  }

  .hint-text {
    color: var(--text);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .hint-image {
    margin-top: 0.85rem;
    max-height: 400px;
    object-fit: contain;
    border: 1px solid var(--border);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
