---
import { url } from '../utils/url';

interface Props {
  id: string;
  title: string;
  description: string;
  cover?: string;
  genre?: string;
  platform?: string;
  stageCount: number;
}

const { id, title, description, cover, genre, platform, stageCount } = Astro.props;
---

<a href={url(`/games/${id}`)} class="game-card">
  <div class="cover">
    {cover
      ? <img src={cover} alt={title} loading="lazy" />
      : <div class="cover-placeholder">{title[0]}</div>
    }
  </div>
  <div class="info">
    <h2>{title}</h2>
    <p class="desc">{description}</p>
    <div class="meta">
      {genre && <span class="tag">{genre}</span>}
      {platform && <span class="tag">{platform}</span>}
      <span class="stages">{stageCount} stage{stageCount !== 1 ? 's' : ''}</span>
    </div>
  </div>
</a>

<style>
  .game-card {
    display: flex;
    gap: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .game-card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    text-decoration: none;
  }

  .cover {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent);
    border-radius: var(--radius-sm);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }

  .desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .stages {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.3);
    color: var(--accent);
  }
</style>
