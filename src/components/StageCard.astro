---
import { langUrl } from '../utils/url';

interface Props {
  gameId: string;
  lang: string;
  stageSlug: string;
  title: string;
  image?: string;
  hintLabel: string;
}

const { gameId, lang, stageSlug, title, image, hintLabel } = Astro.props;
---

<a href={langUrl(lang, `/games/${gameId}/${stageSlug}`)} class="stage-card">
  {image && (
    <div class="stage-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="stage-info">
    <h3>{title}</h3>
    <span class="hint-count">{hintLabel}</span>
  </div>
</a>

<style>
  .stage-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .stage-card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    text-decoration: none;
  }

  .stage-image {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .stage-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .stage-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .hint-count {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
