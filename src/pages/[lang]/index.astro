---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { getCollection } from 'astro:content';
import { locales, useT } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

export async function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useT(lang);

const allGames = await getCollection('games');
const games = allGames
  .filter(g => g.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.order - b.data.order);

const allStages = await getCollection('stages');

function stageCountFor(gameSlug: string) {
  return allStages.filter(
    s => s.id.startsWith(lang + '/') && s.data.game === gameSlug
  ).length;
}
---

<Layout title={t.site_title} description={t.meta_description} lang={lang} localePath="/">
  <header>
    <h1>{t.games_heading}</h1>
    <p class="subtitle">{t.games_subtitle}</p>
  </header>

  {games.length === 0 ? (
    <p class="empty">{t.no_games}</p>
  ) : (
    <div class="games-grid">
      {games.map(game => {
        const slug = game.id.split('/').slice(1).join('/');
        return (
          <GameCard
            id={slug}
            lang={lang}
            title={game.data.title}
            description={game.data.description}
            cover={game.data.cover}
            genre={game.data.genre}
            platform={game.data.platform}
            stagesLabel={t.stage_count(stageCountFor(slug))}
          />
        );
      })}
    </div>
  )}
</Layout>

<style>
  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .games-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: 4rem 0;
  }
</style>
