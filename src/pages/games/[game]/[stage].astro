---
import Layout from '../../../layouts/Layout.astro';
import HintReveal from '../../../components/HintReveal.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stages = await getCollection('stages');
  return stages.map(stage => {
    const [gameId, stageFile] = stage.id.split('/');
    return {
      params: { game: gameId, stage: stageFile },
      props: { stage },
    };
  });
}

const { stage } = Astro.props;
const { game: gameId } = Astro.params;

const games = await getCollection('games');
const game = games.find(g => g.id === gameId);

const allStages = await getCollection('stages');
const gameStages = allStages
  .filter(s => s.data.game === gameId)
  .sort((a, b) => a.data.stage - b.data.stage);

const currentIndex = gameStages.findIndex(s => s.data.stage === stage.data.stage);
const prevStage = gameStages[currentIndex - 1];
const nextStage = gameStages[currentIndex + 1];

function stageUrl(s: typeof stage) {
  const [, file] = s.id.split('/');
  return `/games/${gameId}/${file}`;
}
---

<Layout
  title={`Stage ${stage.data.stage}: ${stage.data.title} — ${game?.data.title ?? ''} — PuzzleHints`}
>
  <nav class="breadcrumb">
    <a href="/">Games</a>
    <span>/</span>
    <a href={`/games/${gameId}`}>{game?.data.title ?? gameId}</a>
    {stage.data.path.map(segment => (
      <>
        <span>/</span>
        <span class="bc-dim">{segment}</span>
      </>
    ))}
    <span>/</span>
    <span>Stage {stage.data.stage}</span>
  </nav>

  {stage.data.image && (
    <div class="stage-banner">
      <img src={stage.data.image} alt={stage.data.title} />
    </div>
  )}

  <header class="stage-header">
    <span class="stage-label">Stage {stage.data.stage}</span>
    <h1>{stage.data.title}</h1>
  </header>

  <section class="hints-section">
    <h2 class="section-title">
      Hints
      <span class="count">{stage.data.hints.length}</span>
    </h2>
    <p class="hint-intro">Click each hint to reveal it. Try the earlier hints before looking at later ones!</p>
    <HintReveal hints={stage.data.hints} />
  </section>

  <nav class="stage-nav">
    {prevStage ? (
      <a href={stageUrl(prevStage)} class="nav-btn prev">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Stage {prevStage.data.stage}
      </a>
    ) : <span />}

    <a href={`/games/${gameId}`} class="nav-btn all">All Stages</a>

    {nextStage ? (
      <a href={stageUrl(nextStage)} class="nav-btn next">
        Stage {nextStage.data.stage}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    ) : <span />}
  </nav>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--accent);
  }

  .bc-dim {
    color: var(--text-muted);
    font-style: italic;
  }

  .stage-banner {
    margin-bottom: 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    max-height: 320px;
    border: 1px solid var(--border);
  }

  .stage-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .stage-header {
    margin-bottom: 2rem;
  }

  .stage-label {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    display: block;
    margin-bottom: 0.35rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .hints-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .count {
    font-size: 0.8rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.1rem 0.5rem;
    border-radius: 100px;
    color: var(--text-muted);
    font-weight: 400;
  }

  .hint-intro {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .stage-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.875rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .nav-btn:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    text-decoration: none;
  }

  .nav-btn.all {
    color: var(--accent);
    border-color: rgba(167, 139, 250, 0.3);
  }
</style>
