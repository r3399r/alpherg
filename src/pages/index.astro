---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import { getCollection } from 'astro:content';

const games = (await getCollection('games')).sort(
  (a, b) => a.data.order - b.data.order
);

const stages = await getCollection('stages');

function stageCountFor(gameId: string) {
  return stages.filter(s => s.data.game === gameId).length;
}
---

<Layout title="PuzzleHints — Game Walkthroughs">
  <header>
    <h1>Puzzle Game Hints</h1>
    <p class="subtitle">Step-by-step hints for every game. Reveal only what you need.</p>
  </header>

  {games.length === 0 ? (
    <p class="empty">No games added yet.</p>
  ) : (
    <div class="games-grid">
      {games.map(game => (
        <GameCard
          id={game.id}
          title={game.data.title}
          description={game.data.description}
          cover={game.data.cover}
          genre={game.data.genre}
          platform={game.data.platform}
          stageCount={stageCountFor(game.id)}
        />
      ))}
    </div>
  )}
</Layout>

<style>
  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .games-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: 4rem 0;
  }
</style>
